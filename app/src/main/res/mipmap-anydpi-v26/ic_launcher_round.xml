<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon built from the supplied SKYORA moon-and-cloud artwork.
  Foreground/background PNGs are generated per density at a 108dp canvas; the
  artwork occupies ~64dp so it stays inside the platform's 72dp safe circle on
  every launcher mask (circle, squircle, rounded square, teardrop).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
