<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared widget plate - night variant: deep-navy gradient, 24dp corners,
  hairline cyan border. WidgetRenderer swaps in widget_background_day/_dusk
  for the matching SkyPhase and keeps this file for night and as fallback.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#12233D"
        android:centerColor="#0B1729"
        android:endColor="#050A15" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#339FC4E8" />
</shape>
