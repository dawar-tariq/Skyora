<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget plate - daylight variant.
  Widgets keep the deep-navy brand card on every treatment (they sit on an
  arbitrary wallpaper), but the top edge and border pick up the phase colour:
  a soft daylight blue here, so a widget on a bright-afternoon screen reads as
  daytime without becoming a low-contrast "sky" card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#1B4E76"
        android:centerColor="#102A45"
        android:endColor="#050A15" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#669FD8F5" />
</shape>
